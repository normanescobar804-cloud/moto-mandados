# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform JS API & Routes API.
# AI Studio injects this automatically after provisioning Google Maps Platform.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Web Push VAPID keys (auto-generated in dev if omitted)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
